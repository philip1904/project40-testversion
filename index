/* ========================================
   NETWORK
   ======================================== */

window.addEventListener(
  "offline",
  ()=>{


    if(
      user
      &&
      challenge
    ){

      const cached =
        loadLocalProgress();


      setSaveStatus(
        cached?.dirty
          ?
          "local"
          :
          "offline"
      );

    }


  }
);


window.addEventListener(
  "online",
  async ()=>{


    if(
      !user
      ||
      !challenge
    ){
      return;
    }


    const cached =
      loadLocalProgress();


    if(
      cached?.dirty
    ){

      if(
        cached.row
      ){

        todayProgress =
          cached.row;

      }


      setSaveStatus(
        "saving"
      );


      await saveToday();

    }else{

      setSaveStatus(
        "saved"
      );

    }


    await loadGroupData();


    mergeTodayIntoAllProgress();


    renderEverything();


    startRealtime();


  }
);


/* ========================================
   AUTH
   ======================================== */

sb.auth.onAuthStateChange(
  (
    event,
    session
  )=>{


    if(
      authFlowBusy
    ){
      return;
    }


    if(
      event ===
        "SIGNED_IN"
      &&
      session?.user
    ){

      user =
        session.user;


      setTimeout(
        ()=>{

          boot();

        },
        0
      );

    }


    if(
      event ===
      "SIGNED_OUT"
    ){

      user =
        null;

      profile =
        null;

      membership =
        null;

      challenge =
        null;

      todayProgress =
        null;

      members =
        [];

      allProgress =
        [];


      showLogin();

    }


  }
);


/* ========================================
   START
   ======================================== */

boot();


