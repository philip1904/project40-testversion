<title>PROJECT 40 ðŸ¦</title>


<style>

:root{
  --bg:#0b0b0c;
  --panel:#171719;
  --panel2:#222225;
  --text:#f7f7f5;
  --muted:#9d9da4;
  --yellow:#f5c518;
  --green:#39d98a;
  --red:#ff6464;
  --orange:#ffbf69;
  --line:#2c2c30;
}

*{
  box-sizing:border-box;
}

html{
  background:var(--bg);
}

body{
  margin:0;
  background:var(--bg);
  color:var(--text);

  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Roboto,
    Arial,
    sans-serif;

  -webkit-font-smoothing:antialiased;
}

button,
input{
  font:inherit;
}

button{
  cursor:pointer;
  touch-action:manipulation;
}

.hidden{
  display:none!important;
}


/* ========================================
   LAYOUT
   ======================================== */

.screen{
  width:min(100%,600px);
  min-height:100dvh;

  margin:0 auto;

  padding:
    calc(20px + env(safe-area-inset-top))
    16px
    calc(110px + env(safe-area-inset-bottom));
}

.center-screen{
  display:flex;

  min-height:100dvh;

  align-items:flex-start;
  justify-content:center;

  padding:
    calc(20px + env(safe-area-inset-top))
    20px
    calc(30px + env(safe-area-inset-bottom));
}

#installGate.center-screen{
  align-items:center;
}

.logo{
  font-size:38px;
  font-weight:950;
  line-height:.95;
  letter-spacing:-1.8px;
}

.logo span{
  color:var(--yellow);
}

.subtitle{
  color:var(--muted);

  margin-top:9px;

  font-size:14px;
  line-height:1.45;
}

.card{
  background:var(--panel);

  border:1px solid var(--line);
  border-radius:20px;

  padding:17px;
  margin-bottom:12px;
}

.auth-card{
  width:min(100%,460px);
}

.auth-card .logo{
  margin-bottom:24px;
}

label{
  display:block;

  color:#d4d4d7;

  font-size:13px;
  font-weight:850;

  margin:14px 0 7px;
}

input{
  display:block;

  width:100%;

  border:1px solid var(--line);

  background:#101012;
  color:white;

  padding:15px;

  border-radius:14px;

  outline:none;
}

input:focus{
  border-color:var(--yellow);
}


/* ========================================
   BUTTONS
   ======================================== */

.btn{
  border:0;

  border-radius:14px;

  padding:14px 12px;

  background:var(--panel2);
  color:var(--text);

  font-weight:900;
}

.btn:active{
  transform:scale(.98);
}

.btn.primary{
  background:var(--yellow);
  color:#111;
}

.btn.green{
  background:var(--green);
  color:#071911;
}

.btn.red{
  background:rgba(255,100,100,.14);
  color:#ff8585;
}

.btn.orange{
  background:rgba(255,191,105,.13);
  color:#ffd19b;

  border:1px solid rgba(255,191,105,.25);
}

.btn.full{
  width:100%;

  margin-top:18px;

  padding:16px;
}

.btn:disabled{
  opacity:.32;

  cursor:default;

  transform:none;
}


/* ========================================
   MESSAGES
   ======================================== */

.message{
  margin-top:14px;

  padding:12px;

  border-radius:12px;

  font-size:13px;
  line-height:1.5;

  background:var(--panel2);

  color:var(--muted);
}

.message.ok{
  color:var(--green);
}

.message.error{
  color:#ff8d8d;
}

.divider{
  display:flex;

  align-items:center;

  gap:12px;

  margin:25px 0 10px;

  color:var(--muted);

  font-size:10px;
  font-weight:900;

  letter-spacing:1px;
}

.divider::before,
.divider::after{
  content:"";

  height:1px;

  flex:1;

  background:var(--line);
}

.section-title{
  margin:23px 2px 10px;

  font-size:12px;

  color:var(--muted);

  font-weight:950;

  letter-spacing:1.2px;
}

.small{
  color:var(--muted);

  font-size:12px;
  line-height:1.5;
}


/* ========================================
   INSTALL
   ======================================== */

.install-gate{
  width:min(100%,460px);
}

.install-icon{
  width:92px;
  height:92px;

  margin:0 auto 18px;

  border-radius:22px;

  background:var(--yellow);
  color:#111;

  display:flex;

  align-items:center;
  justify-content:center;

  font-size:39px;
  font-weight:950;
}

.install-gate h1{
  margin:0;

  text-align:center;

  font-size:27px;
}

.install-gate .intro{
  margin:12px 0 20px;

  text-align:center;

  color:#d7d7da;

  line-height:1.5;
}

.install-steps{
  background:#101012;

  border:1px solid var(--line);
  border-radius:17px;

  padding:15px;

  margin-top:15px;

  line-height:1.6;

  font-size:13px;
}

.install-steps strong{
  color:var(--yellow);
}

.install-required{
  margin-top:15px;

  border:1px solid rgba(245,197,24,.35);

  background:rgba(245,197,24,.07);

  border-radius:15px;

  padding:13px;

  text-align:center;

  color:var(--yellow);

  font-size:12px;
  font-weight:900;

  line-height:1.5;
}


/* ========================================
   LOGIN
   ======================================== */

.choice-block{
  margin-top:23px;
  padding-top:2px;
}

.choice-heading{
  color:var(--yellow);

  font-size:13px;
  font-weight:950;

  letter-spacing:.7px;

  margin-bottom:6px;
}

.choice-text{
  color:var(--muted);

  font-size:12px;
  line-height:1.5;

  margin-bottom:3px;
}


/* ========================================
   OVERLAY
   ======================================== */

.overlay{
  position:fixed;

  inset:0;

  z-index:2000;

  background:rgba(0,0,0,.94);

  display:flex;

  align-items:center;
  justify-content:center;

  padding:
    calc(20px + env(safe-area-inset-top))
    16px
    calc(20px + env(safe-area-inset-bottom));
}

.overlay-card{
  width:min(100%,480px);

  max-height:90dvh;

  overflow:auto;

  background:var(--panel);

  border:1px solid rgba(245,197,24,.4);

  border-radius:24px;

  padding:20px;
}

.overlay-icon{
  font-size:52px;
  text-align:center;
}

.overlay-card h2{
  margin:8px 0;

  text-align:center;

  font-size:25px;
}

.overlay-card p{
  color:#d4d4d7;

  line-height:1.5;

  font-size:13px;
}

.recovery-code{
  margin:17px 0;

  padding:17px 10px;

  border:1px solid rgba(245,197,24,.4);

  border-radius:15px;

  background:#0d0d0f;

  color:var(--yellow);

  text-align:center;

  font-size:19px;
  font-weight:950;

  letter-spacing:1px;

  word-break:break-word;
}

.warning-box{
  margin-top:15px;

  padding:13px;

  border-radius:14px;

  background:rgba(255,191,105,.08);

  border:1px solid rgba(255,191,105,.25);

  color:#ffd19b;

  font-size:12px;

  line-height:1.5;
}


/* ========================================
   TOP
   ======================================== */

.topbar{
  display:flex;

  align-items:center;
  justify-content:space-between;

  gap:12px;

  margin-bottom:16px;
}

.topbar .logo{
  font-size:27px;
}

.userpill{
  border:1px solid var(--line);

  border-radius:999px;

  padding:8px 10px;

  background:var(--panel);

  color:var(--muted);

  font-size:12px;
  font-weight:850;
}

.hero{
  background:
    linear-gradient(
      135deg,
      #f5c518,
      #dca900
    );

  color:#111;

  border-radius:22px;

  padding:19px;

  margin-bottom:14px;
}

.hero-row{
  display:flex;

  justify-content:space-between;

  gap:12px;
}

.hero-day{
  font-size:35px;

  font-weight:950;

  letter-spacing:-1.5px;
}

.hero-date{
  margin-top:4px;

  font-size:12px;

  font-weight:850;

  opacity:.7;
}

.hero-right{
  text-align:right;

  font-size:12px;

  font-weight:950;
}

.progressbar{
  margin-top:16px;

  height:9px;

  border-radius:99px;

  background:rgba(0,0,0,.16);

  overflow:hidden;
}

.progressbar div{
  height:100%;

  width:0%;

  border-radius:99px;

  background:#111;

  transition:.25s;
}

.complete-banner{
  display:none;

  margin-bottom:12px;

  background:var(--green);

  color:#071911;

  border-radius:19px;

  text-align:center;

  padding:16px;
}

.complete-banner.show{
  display:block;
}

.complete-title{
  font-size:20px;

  font-weight:950;
}

.complete-sub{
  margin-top:4px;

  font-size:12px;

  font-weight:850;

  opacity:.72;
}


/* ========================================
   NAV
   ======================================== */

.nav{
  display:grid;

  grid-template-columns:repeat(3,1fr);

  gap:7px;

  margin-bottom:7px;
}

.nav button{
  border:1px solid var(--line);

  border-radius:13px;

  background:var(--panel);

  color:var(--muted);

  padding:11px 4px;

  font-weight:900;

  font-size:12px;
}

.nav button.active{
  background:var(--yellow);

  color:#111;

  border-color:var(--yellow);
}


/* ========================================
   SAVE
   ======================================== */

.save-status{
  min-height:20px;

  margin:0 0 9px;

  text-align:center;

  font-size:11px;
  font-weight:900;

  color:var(--muted);

  display:flex;

  align-items:center;
  justify-content:center;

  gap:6px;
}

.save-status::before{
  content:"";

  width:7px;
  height:7px;

  border-radius:50%;

  background:var(--muted);
}

.save-status.saving{
  color:var(--yellow);
}

.save-status.saving::before{
  background:var(--yellow);
}

.save-status.saved{
  color:var(--green);
}

.save-status.saved::before{
  background:var(--green);
}

.save-status.local,
.save-status.offline{
  color:var(--orange);
}

.save-status.local::before,
.save-status.offline::before{
  background:var(--orange);
}


/* ========================================
   TASKS
   ======================================== */

.card-title{
  display:flex;

  justify-content:space-between;
  align-items:center;

  gap:10px;
}

.card-title h2{
  margin:0;

  font-size:18px;

  letter-spacing:-.3px;
}

.badge{
  border-radius:999px;

  background:var(--panel2);

  color:var(--muted);

  padding:6px 9px;

  font-size:12px;
  font-weight:900;

  white-space:nowrap;
}

.card.done{
  border-color:rgba(57,217,138,.5);
}

.badge.done{
  background:rgba(57,217,138,.14);

  color:var(--green);
}

.big-number{
  margin:17px 0 5px;

  font-size:44px;

  line-height:1;

  font-weight:950;

  letter-spacing:-2px;
}

.target{
  color:var(--muted);

  font-size:13px;

  line-height:1.5;
}

.exercise-note{
  margin-top:11px;

  padding:10px 11px;

  border-radius:12px;

  background:#101012;

  color:#cfcfd3;

  font-size:12px;

  line-height:1.5;
}

.btnrow{
  display:grid;

  grid-template-columns:repeat(4,1fr);

  gap:8px;

  margin-top:16px;
}

.btnrow.three{
  grid-template-columns:repeat(3,1fr);
}

.locked-note{
  margin-top:12px;

  padding:10px;

  border-radius:12px;

  background:rgba(57,217,138,.1);

  color:var(--green);

  text-align:center;

  font-size:12px;
  font-weight:900;
}


/* ========================================
   SHOULDER MODE
   ======================================== */

.shoulder-toggle{
  border-color:rgba(255,191,105,.22);
}

.shoulder-toggle.active{
  border-color:rgba(255,191,105,.6);

  background:rgba(255,191,105,.08);
}

.shoulder-title{
  font-size:16px;

  font-weight:950;
}

.shoulder-sub{
  margin-top:6px;

  color:var(--muted);

  font-size:12px;

  line-height:1.5;
}

.shoulder-active-label{
  display:inline-block;

  margin-top:10px;

  padding:6px 9px;

  border-radius:999px;

  background:rgba(255,191,105,.14);

  color:#ffd19b;

  font-size:10px;

  font-weight:950;

  letter-spacing:.5px;
}

.shoulder-tech{
  border-color:rgba(255,191,105,.4);

  background:rgba(255,191,105,.06);
}

.shoulder-tech h2{
  color:#ffd19b;
}

.shoulder-tech p{
  color:#d5d5d9;

  font-size:12px;

  line-height:1.55;
}


/* ========================================
   PLANK
   ======================================== */

.timer{
  text-align:center;

  font-size:68px;

  line-height:1;

  font-weight:950;

  letter-spacing:-3px;

  font-variant-numeric:tabular-nums;

  margin:22px 0 6px;
}

.timer-sub{
  text-align:center;

  color:var(--muted);

  font-size:12px;
}

.timer-buttons{
  display:grid;

  grid-template-columns:2fr 1fr;

  gap:9px;

  margin-top:17px;
}

.timer-buttons button{
  padding:16px;
}

.sets{
  color:var(--muted);

  font-size:12px;

  line-height:1.5;

  margin-top:13px;
}


/* ========================================
   RULES
   ======================================== */

.rulebox{
  border-color:rgba(245,197,24,.4);

  background:rgba(245,197,24,.06);
}

.rulebox strong{
  color:var(--yellow);
}

.rules{
  margin:9px 0 0 19px;

  padding:0;

  color:#d4d4d7;

  font-size:13px;

  line-height:1.6;
}

.actionrow{
  display:grid;

  grid-template-columns:1fr 1fr;

  gap:9px;
}


/* ========================================
   GROUP
   ======================================== */

.group-summary{
  display:grid;

  grid-template-columns:repeat(3,1fr);

  gap:8px;

  margin:15px 0 8px;
}

.statbox{
  background:var(--panel2);

  border-radius:14px;

  padding:12px 6px;

  text-align:center;
}

.statbox strong{
  display:block;

  font-size:22px;

  color:var(--yellow);
}

.statbox span{
  display:block;

  margin-top:3px;

  color:var(--muted);

  font-size:9px;
  font-weight:900;

  letter-spacing:.5px;
}

.member{
  display:flex;

  align-items:center;

  gap:11px;

  padding:14px 0;

  border-bottom:1px solid var(--line);
}

.member:last-child{
  border-bottom:0;
}

.avatar{
  width:42px;
  height:42px;

  flex:0 0 42px;

  border-radius:50%;

  background:var(--yellow);

  color:#111;

  display:flex;

  align-items:center;
  justify-content:center;

  font-size:18px;
  font-weight:950;
}

.member-main{
  flex:1;

  min-width:0;
}

.member-name{
  font-weight:900;
}

.member-status{
  color:var(--muted);

  font-size:11px;

  margin-top:3px;
}

.member-streak{
  color:#d4d4d7;

  font-size:10px;

  margin-top:4px;
}

.member-score{
  text-align:right;

  font-size:12px;

  font-weight:900;
}

.member-score .green{
  color:var(--green);
}

.joincode{
  font-size:27px;

  font-weight:950;

  letter-spacing:3px;

  color:var(--yellow);

  margin-top:8px;
}


/* ========================================
   PROFILE
   ======================================== */

.profile-code-label{
  margin-top:14px;

  color:var(--muted);

  font-size:10px;

  font-weight:900;

  letter-spacing:.8px;
}

.profile-code{
  margin-top:7px;

  padding:13px 9px;

  border-radius:13px;

  background:#101012;

  color:var(--yellow);

  text-align:center;

  font-size:15px;

  font-weight:950;

  letter-spacing:.7px;

  word-break:break-word;
}

.profile-actions{
  display:grid;

  grid-template-columns:1fr 1fr;

  gap:8px;

  margin-top:9px;
}


/* ========================================
   HISTORY
   ======================================== */

.history{
  display:grid;

  grid-template-columns:repeat(5,1fr);

  gap:7px;
}

.daybox{
  min-height:58px;

  border:1px solid var(--line);

  border-radius:13px;

  background:var(--panel);

  display:flex;

  flex-direction:column;

  align-items:center;
  justify-content:center;

  gap:2px;
}

.daybox strong{
  font-size:15px;
}

.daybox span{
  font-size:11px;

  color:var(--muted);
}

.daybox.complete{
  border-color:rgba(57,217,138,.5);

  background:rgba(57,217,138,.13);
}

.daybox.partial{
  border-color:rgba(245,197,24,.4);

  background:rgba(245,197,24,.08);
}

.daybox.prejoin{
  opacity:.35;
}

.daybox.future{
  opacity:.22;
}

.daybox.today{
  outline:2px solid var(--yellow);
}


/* ========================================
   OTHER
   ======================================== */

.rest{
  text-align:center;

  padding:38px 20px;
}

.rest .emoji{
  font-size:60px;
}

.rest h2{
  margin:10px 0 5px;

  font-size:29px;
}

.rest p{
  color:var(--muted);

  line-height:1.55;
}

.choice-grid{
  display:grid;

  grid-template-columns:1fr;

  gap:12px;
}

.choice-card h2{
  margin:0 0 7px;
}

.choice-card p{
  color:var(--muted);

  margin:0;

  line-height:1.45;

  font-size:13px;
}

.toast{
  position:fixed;

  left:50%;

  bottom:calc(20px + env(safe-area-inset-bottom));

  z-index:3000;

  transform:translateX(-50%);

  width:min(calc(100% - 32px),500px);

  background:#27272b;

  border:1px solid #3b3b40;

  color:white;

  padding:13px 15px;

  border-radius:14px;

  font-size:13px;

  opacity:0;

  pointer-events:none;

  transition:.2s;
}

.toast.show{
  opacity:1;
}

</style>

</head>


