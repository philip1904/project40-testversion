function toggleDone(
  cardId,
  badgeId,
  done
){

  document
    .getElementById(
      cardId
    )
    .classList
    .toggle(
      "done",
      done
    );


  document
    .getElementById(
      badgeId
    )
    .classList
    .toggle(
      "done",
      done
    );

}


function formatSeconds(sec){

  sec =
    Math.max(
      0,
      Math.floor(
        sec || 0
      )
    );


  const min =
    Math.floor(
      sec / 60
    );


  const seconds =
    sec % 60;


  return (
    `${min}:`
    +
    String(
      seconds
    )
    .padStart(
      2,
      "0"
    )
  );

}


function formatTask(
  value,
  task
){

  if(
    task.unit ===
    "sec"
  ){

    return (
      `${formatSeconds(value)}/${formatSeconds(task.target)}`
    );

  }


  return (
    `${value}/${task.target}`
  );

}


function escapeHtml(text){

  const div =
    document.createElement(
      "div"
    );


  div.textContent =
    text
    ||
    "";


  return div.innerHTML;

}


function toast(text){

  const el =
    document.getElementById(
      "toast"
    );


  el.textContent =
    text;


  el.classList
    .add(
      "show"
    );


  setTimeout(
    ()=>{


      el.classList
        .remove(
          "show"
        );


    },
    2800
  );

}


