/* ========================================
   SAVE TODAY
   ======================================== */

async function saveToday(){

  if(
    !todayProgress
  ){
    return;
  }


  saveLocalProgress(
    todayProgress,
    true
  );


  mergeTodayIntoAllProgress();


  if(
    !navigator.onLine
  ){

    setSaveStatus(
      "local"
    );

    return;
  }


  if(
    saveInFlight
  ){

    savePending =
      true;

    setSaveStatus(
      "saving"
    );

    return;
  }


  saveInFlight =
    true;


  setSaveStatus(
    "saving"
  );


  try{


    do{


      savePending =
        false;


      const payload =
        buildProgressPayload(
          todayProgress
        );


      const {
        data,
        error
      } =
        await sb
          .from(
            "daily_progress"
          )
          .upsert(
            payload,
            {
              onConflict:
                "challenge_id,user_id,workout_date"
            }
          )
          .select()
          .single();


      if(error){

        console.error(
          error
        );


        saveLocalProgress(
          todayProgress,
          true
        );


        setSaveStatus(
          "local"
        );


        toast(
          "Sparat pÃ¥ telefonen â€“ synkar senare."
        );


        return;
      }


      if(
        data?.id
      ){

        todayProgress.id =
          data.id;

      }


      if(
        data?.updated_at
      ){

        todayProgress.updated_at =
          data.updated_at;

      }


      if(
        !savePending
      ){

        saveLocalProgress(
          todayProgress,
          false
        );


        setSaveStatus(
          "saved"
        );

      }


    }while(
      savePending
      &&
      navigator.onLine
    );


  }finally{


    saveInFlight =
      false;


  }


  mergeTodayIntoAllProgress();


  renderEverything();

}


