/* ========================================
   CHALLENGE DAYS
   ======================================== */

function challengeDates(){

  if(!challenge){
    return [];
  }


  let d =
    parseDate(
      challenge.start_date
    );


  const result = [];


  while(
    result.length < 40
  ){

    if(
      isWeekday(d)
    ){

      result.push(
        new Date(d)
      );

    }


    d =
      addDays(
        d,
        1
      );

  }


  return result;

}


function challengeDayForDate(date){

  const key =
    localDateKey(
      date
    );


  const dates =
    challengeDates();


  const index =
    dates.findIndex(
      d =>
        localDateKey(d)
        === key
    );


  return (
    index === -1
      ? null
      : index + 1
  );

}


/* ========================================
   TRAINING PLAN
   ======================================== */

function trainingPlanForDate(date){

  const dayNumber =
    challengeDayForDate(
      date
