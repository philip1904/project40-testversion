  if(
    !dayNumber ||
    !isWeekday(date)
  ){
    return null;
  }


  const weekday =
    date.getDay();


  let mainName;


  if(
    weekday === 5
  ){

    mainName =
      "BURPEES";

  }

  else if(
    weekday === 1 ||
    weekday === 3
  ){

    mainName =
      "SMALA PUSH-UPS";

  }

  else{

    mainName =
      "AIR SQUATS";

  }


  const bmu =
    BMU_PLAN[
      weekday
    ];


  return {

    dayNumber,

    main:{
      name:mainName,
      target:100
    },

    bmu1:
      bmu[0],

    bmu2:
      bmu[1]

  };

}


