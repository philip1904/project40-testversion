/* ========================================
   SCORES
   ======================================== */

function eligibleDaysForMember(
  joinedAt
){

  const join =
    parseDate(
      joinedAt
    );


  const t =
    todayDate();


  return challengeDates()
    .filter(
      d =>
        d >= join
        &&
        d <= t
    )
    .length;

}


function completedDaysForMember(
  userId,
  joinedAt
){

  const join =
    parseDate(
      joinedAt
    );


  const t =
    todayDate();


  return challengeDates()

    .filter(
      date =>
        date >= join
        &&
        date <= t
    )

    .filter(
      date=>{


        const row =
          allProgress.find(
            p =>
              p.user_id ===
                userId
              &&
              p.workout_date ===
                localDateKey(date)
          );


        return progressComplete(
          row,
          date
        );


      }
    )

    .length;

}


function memberCompletionPercent(
  member
){

  const eligible =
    eligibleDaysForMember(
      member.joined_at
    );


  if(
    !eligible
  ){
    return 0;
  }


  const complete =
    completedDaysForMember(
      member.user_id,
      member.joined_at
    );


  return Math.round(
    complete
    /
    eligible
    *
    100
  );

}


function currentStreakForMember(
  userId,
  joinedAt
){

  const join =
    parseDate(
      joinedAt
    );


  const t =
    todayDate();


  let dates =
    challengeDates()
      .filter(
        date =>
          date >= join
          &&
          date <= t
      );


  if(
    !dates.length
  ){
    return 0;
  }


  const last =
    dates[
      dates.length-1
    ];


  if(
    localDateKey(
      last
    )
    ===
    localDateKey(
      t
    )
  ){

    const row =
      allProgress.find(
        p =>
          p.user_id ===
            userId
          &&
          p.workout_date ===
            localDateKey(t)
      );


    if(
      !progressComplete(
        row,
        t
      )
    ){

      dates.pop();

    }

  }


  let streak =
    0;


  for(
    let i =
      dates.length-1;
    i >= 0;
    i--
  ){

    const date =
      dates[
        i
      ];


    const row =
      allProgress.find(
        p =>
          p.user_id ===
            userId
          &&
          p.workout_date ===
            localDateKey(date)
      );


    if(
      progressComplete(
        row,
        date
      )
    ){

      streak++;

    }else{

      break;

    }

  }


  return streak;

}


function todayStatusText(row){

  if(!row){

    return "Inte pÃ¥bÃ¶rjad";

  }


  const plan =
    trainingPlanForDate(
      todayDate()
    );


  if(!plan){

    return "Vilodag";

  }


  const techniqueDone =
    (
      row.bmu1_value
      >=
      plan.bmu1.target
        ?
        1
        :
        0
    )
    +
    (
