/* ========================================
   PLANK TIMER
   ======================================== */

function plankStorageKey(){

  if(!user){
    return null;
  }


  return [
    "p40_plank",
    user.id,
    localDateKey()
  ].join("_");

}


function activePlank(){

  const key =
    plankStorageKey();


  if(!key){
    return null;
  }


  return safeRead(
    key
  );

}


function displayedPlankSeconds(){

  if(
    !todayProgress
  ){
    return 0;
  }


  const active =
    activePlank();


  if(!active){

    return (
      todayProgress
        .plank_seconds
      ||
      0
    );

  }


  const elapsed =
    Math.floor(
      (
        Date.now()
        -
        active.startedAt
      )
      /
      1000
    );


  return Math.min(
    300,
    todayProgress
      .plank_seconds
    +
    Math.max(
      0,
      elapsed
    )
  );

}


function togglePlank(){

  if(
    activePlank()
  ){

    stopPlank();

  }else{

    startPlank();

  }

}


function startPlank(){

  if(
    !todayProgress
  ){
    return;
  }


  if(
    todayProgress
      .plank_seconds
    >=
    300
  ){
    return;
  }


  safeWrite(
    plankStorageKey(),
    {
      startedAt:
        Date.now()
    }
  );


  startPlankInterval();


  renderPlank();

}


async function stopPlank(
  auto = false
){

  if(
    plankStopping
  ){
    return;
  }


  const active =
    activePlank();


  if(
    !active
    ||
    !todayProgress
  ){
    return;
  }


  plankStopping =
    true;


  let elapsed =
    Math.floor(
      (
        Date.now()
        -
        active.startedAt
      )
      /
      1000
    );


  elapsed =
    Math.max(
      1,
      elapsed
    );


  const remaining =
    Math.max(
      0,
      300
      -
      todayProgress
        .plank_seconds
    );


  const added =
    Math.min(
      elapsed,
      remaining
    );


  if(
    added > 0
  ){

    todayProgress
      .plank_seconds
      +=
      added;


    if(
      !Array.isArray(
        todayProgress
          .plank_sets
      )
    ){

      todayProgress
        .plank_sets =
          [];

    }


    todayProgress
      .plank_sets
      .push(
        added
      );

  }


  localStorage.removeItem(
    plankStorageKey()
  );


  stopPlankInterval();


  await saveToday();


  plankStopping =
    false;


  if(
    !auto
  ){

    renderPlank();

  }

}


async function undoPlank(){

  if(
    !todayProgress
    ||
    activePlank()
  ){
    return;
  }


  const sets =
    Array.isArray(
      todayProgress
        .plank_sets
    )
      ?
      [
        ...todayProgress
          .plank_sets
      ]
      :
      [];


  if(
    !sets.length
  ){
    return;
  }


  const last =
    sets.pop();


  todayProgress
    .plank_sets =
      sets;


  todayProgress
    .plank_seconds =
      Math.max(
        0,
        todayProgress
          .plank_seconds
        -
        last
      );


  await saveToday();

}


function startPlankInterval(){

  stopPlankInterval();


  plankInterval =
    setInterval(
      async ()=>{


        renderPlank();


        if(
