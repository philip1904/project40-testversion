/* ========================================
   NAV
   ======================================== */

function showTab(tab){

  [
    "day",
    "group",
    "history"
  ]
  .forEach(
    name=>{


      document
        .getElementById(
          `tab${capitalize(name)}`
        )
        .classList
        .toggle(
          "hidden",
          name !== tab
        );


      document
        .getElementById(
          `nav${capitalize(name)}`
        )
        .classList
        .toggle(
          "active",
          name === tab
        );


    }
  );

}


function capitalize(s){

  return (
    s
      .charAt(0)
      .toUpperCase()
    +
    s.slice(1)
  );

}


