function renderBmu(
  index,
  task,
  value
){

  const prefix =
    `bmu${index}`;


  document
    .getElementById(
      `${prefix}Name`
    )
    .textContent =
      task.name;


  document
    .getElementById(
      `${prefix}Number`
    )
    .textContent =
      task.unit ===
        "sec"
        ?
        formatSeconds(
          value
        )
        :
        value;


  document
    .getElementById(
      `${prefix}Target`
    )
    .textContent =
      task.unit ===
        "sec"
        ?
        `av ${formatSeconds(task.target)} totalt`
        :
        `av ${task.target} reps totalt`;


  document
    .getElementById(
      `${prefix}Badge`
    )
    .textContent =
      task.unit ===
        "sec"
        ?
        `${formatSeconds(value)} / ${formatSeconds(task.target)}`
        :
        `${value} / ${task.target}`;


  toggleDone(
    `${prefix}Card`,
    `${prefix}Badge`,
    value >=
      task.target
  );


  const holder =
    document.getElementById(
      `${prefix}Buttons`
    );


  holder.innerHTML =
    "";


  task.buttons
    .forEach(
      (amount,index)=>{


        const button =
          document.createElement(
            "button"
          );


        button.className =
          "btn"
          +
          (
            index ===
              task.buttons.length-1
              ?
              " primary"
              :
              ""
          );


        button.textContent =
          task.unit ===
            "sec"
            ?
            `+${amount}s`
            :
            `+${amount}`;


        button.disabled =
          value >=
            task.target;


        button.onclick =
          ()=>
            addBmu(
              Number(
                prefix.replace(
                  "bmu",
                  ""
                )
              ),
              amount
            );


        holder.appendChild(
          button
        );


      }
    );

}


