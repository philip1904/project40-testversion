function scheduleRealtimeRefresh(){

  clearTimeout(
    realtimeRefreshTimer
  );


  realtimeRefreshTimer =
    setTimeout(
      async ()=>{


        await loadGroupData();


        const cached =
          loadLocalProgress();


        if(
          cached?.dirty
          &&
          cached?.row
        ){

          todayProgress =
            cached.row;

        }


        mergeTodayIntoAllProgress();


        renderGroup();

        renderHistory();

        renderHeader();

        renderDay();


      },
      350
    );

}


function stopRealtime(){

  if(
    realtimeChannel
  ){

    sb.removeChannel(
      realtimeChannel
    );


    realtimeChannel =
      null;

  }

}


